  "changepassword": {
    "source": "pages\\section\\changepassword.html",
    "fields": [
      {
        "required": "required",
        "class": [
          "form-control",
          "password-input"
        ],
        "type": "{{showCurrentPassword ? 'text' : 'password'}}",
        "data-ng-model": "changePasswordData.currentPassword",
        "name": "currentPassword",
        "autocomplete": "off",
        "ng-blur": "hidePassword('showCurrentPassword')"
      },
      {
        "required": "required",
        "class": [
          "form-control",
          "password-input"
        ],
        "type": "{{showNewPassword ? 'text' : 'password'}}",
        "data-ng-model": "changePasswordData.password",
        "id": "changePasswordData.password",
        "name": "password",
        "autocomplete": "off",
        "data-ng-minlength": "6",
        "maxlength": "15",
        "ng-blur": "hidePassword('showNewPassword')"
      },
      {
        "required": "required",
        "class": [
          "form-control",
          "password-input"
        ],
        "type": "{{showConfirmPassword ? 'text' : 'password'}}",
        "data-ng-model": "changePasswordData.confirmPassword",
        "name": "confirmPassword",
        "autocomplete": "off",
        "ng-blur": "hidePassword('showConfirmPassword')"
      },
      {
        "class": [
          "form-control"
        ],
        "type": "text",
        "data-ng-model": "changePasswordData.otp",
        "name": "otp",
        "maxlength": "6",
        "autocomplete": "off"
      }
    ],
    "events": [
      "changePasswordData.password=''",
      "changePasswordFunction(changePasswordForm.$valid)",
      "changePasswordFunction1()",
      "hidePassword('showConfirmPassword')",
      "hidePassword('showCurrentPassword')",
      "hidePassword('showNewPassword')",
      "toggleConfirmPassword($event)",
      "toggleCurrentPassword($event)",
      "toggleNewPassword($event)",
      "verifyUserPasswordExpiry()"
    ]
  }
