{
  "collector/dashboard": {
    "fields": [
      {
        "type": "text",
        "class": [
          "form-control"
        ],
        "placeholder": "Search by application no / unit name",
        "data-ng-model": "searchText"
      }
    ],
    "events": [
      "downloadCollectorSignedDoc(app.applicationId)",
      "loadProcessed()",
      "viewProgress(app)"
    ],
    "inlineScripts": 1
  },
  "collector/detail": {
    "fields": [],
    "events": [
      "loadDetail()",
      "viewProgress({applicationId: (detail.applicationId||applicationNo)})"
    ],
    "inlineScripts": 1
  },
  "collector/esignApproval": {
    "fields": [
      {
        "type": "radio",
        "data-ng-model": "signOption",
        "value": "eSign"
      },
      {
        "type": "radio",
        "data-ng-model": "signOption",
        "value": "DSC"
      },
      {
        "class": [
          "form-control",
          "number-only"
        ],
        "maxlength": "4",
        "type": "text",
        "data-ng-model": "aadhaarLast4Digits"
      },
      {
        "type": "hidden",
        "name": "msg",
        "value": "",
        "id": "msg"
      }
    ],
    "events": [
      "downloadSigned(signedAppNo)",
      "dscSign()",
      "eSignApprove()",
      "initEsignApproval()"
    ],
    "inlineScripts": 1
  },
  "collector/approved": {
    "fields": [
      {
        "type": "text",
        "class": [
          "form-control"
        ],
        "placeholder": "Search by application no / unit name",
        "data-ng-model": "searchText"
      }
    ],
    "events": [
      "downloadSigned(app.applicationId)",
      "loadApproved()",
      "viewProgress(app)"
    ],
    "inlineScripts": 1
  },
  "collector/batches": {
    "fields": [
      {
        "class": [
          "form-control",
          "input-sm"
        ],
        "data-ng-model": "a.remark",
        "data-ng-change": "onRemarkChange(a)"
      },
      {
        "type": "text",
        "maxlength": "1000",
        "class": [
          "form-control",
          "input-sm"
        ],
        "style": "width:100%",
        "data-ng-model": "a.remarkText",
        "placeholder": "Optional note"
      },
      {
        "type": "number",
        "min": "0",
        "class": [
          "form-control",
          "input-sm"
        ],
        "style": "height:22px; padding:2px 4px; font-size:12px",
        "data-ng-model": "asst.sanctionedAmount"
      },
      {
        "type": "number",
        "min": "0",
        "class": [
          "form-control",
          "input-sm"
        ],
        "data-ng-model": "a.sanctionedAmount",
        "placeholder": "Amount"
      }
    ],
    "events": [
      "approveBatch()",
      "closeAssistanceRemark()",
      "closeBatch()",
      "downloadCoveringLetter(b)",
      "loadBatches()",
      "onRemarkChange(a)",
      "openBatch(b)",
      "showAssistanceRemark(asst)",
      "submitBatch()",
      "viewProgress({applicationId: a.applicationNo})"
    ],
    "inlineScripts": 1
  },
  "collector/batchSign": {
    "fields": [
      {
        "type": "checkbox",
        "data-ng-model": "approveConfirmed"
      }
    ],
    "events": [
      "approveBatchWithoutSign()",
      "closeAssistanceRemark()",
      "downloadBatchSigned()",
      "initBatchSign()",
      "printBatchPdf()",
      "showAssistanceRemark(asst)"
    ],
    "inlineScripts": 1
  },
