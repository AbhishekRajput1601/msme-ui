{
  "ldm/dashboard": {
    "fields": [],
    "events": [
      "loadApplications()"
    ],
    "inlineScripts": 1
  },
  "ldm/verification": {
    "fields": [
      {
        "type": "text",
        "class": [
          "form-control"
        ],
        "placeholder": "Search by application no / unit name",
        "data-ng-model": "searchText"
      },
      {
        "type": "checkbox",
        "data-ng-model": "app.selected",
        "data-ng-disabled": "isProcessed(app)"
      },
      {
        "type": "text",
        "class": [
          "form-control",
          "input-sm"
        ],
        "maxlength": "2000",
        "data-ng-model": "app.remark",
        "placeholder": "Enter remark",
        "style": "display:inline-block;width:78%"
      }
    ],
    "events": [
      "loadApplications()",
      "openRemarks(app)",
      "submitQuery()",
      "submitVerify()",
      "viewDetail(app)",
      "viewHistory(app)",
      "viewProgress(app)"
    ],
    "inlineScripts": 1
  },
  "ldm/batches": {
    "fields": [
      {
        "class": [
          "form-control",
          "input-sm"
        ],
        "data-ng-model": "a.remark"
      },
      {
        "type": "text",
        "maxlength": "1000",
        "class": [
          "form-control",
          "input-sm"
        ],
        "data-ng-model": "a.remarkText",
        "placeholder": "Optional note"
      }
    ],
    "events": [
      "closeAssistanceRemark()",
      "closeBatch()",
      "downloadCoveringLetter(b)",
      "loadBatches()",
      "openBatch(b)",
      "showAssistanceRemark(asst)",
      "submitBatch('Approve')",
      "submitBatch('Query')",
      "submitBatch('Reject')",
      "submitBatch()",
      "viewProgress({applicationId: a.applicationNo})"
    ],
    "inlineScripts": 1
  },
  "ldm/detail": {
    "fields": [],
    "events": [
      "loadDetail()",
      "viewProgress({applicationId: (detail.applicationId||applicationNo)})"
    ],
    "inlineScripts": 1
  },
